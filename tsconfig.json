{
    "compilerOptions": {
        "outDir": "dist",
        "target": "es6",
        "strict": true,
        "moduleResolution": "node",
        "module": "commonjs",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strictNullChecks": true,
        "noImplicitOverride": true,
        "resolveJsonModule": true,
        "lib": [ "ES2020.String" ],
        "baseUrl": "./src",
        "typeRoots": [ "@types", "./node_modules/@types" ]
    },
    "include": [
        "src/**/*",
        "environment.d.ts"
    ]
}